        "from datetime import datetime\n",
        "\n",
        "# === PART 4: STRETCH CHALLENGE — Option A: Email Report Generator ===\n",
        "\n",
        "def generate_email_report(df, high_risk_df, alerts_df):\n",
        "\n",
        "    # High risk patient names\n",
        "    high_risk_names = \"\\n\".join(\n",
        "        f\"  - {row['name']} ({row['diagnosis']})\"\n",
        "        for _, row in high_risk_df.iterrows()\n",
        "    )\n",
        "\n",
        "    # Drug alert details\n",
        "    alert_details = \"\\n\".join(\n",
        "        f\"  - {row['patient_name']}: {row['drug1']} + {row['drug2']} → {row['description']}\"\n",
        "        for _, row in alerts_df.iterrows()\n",
        "    )\n",
        "\n",
        "    report = f\"\"\"\n",
        "TO:      oncology.team@khcc.jo\n",
        "FROM:    intake.system@khcc.jo\n",
        "SUBJECT: Daily Intake Report — {datetime.now().strftime(\"%Y-%m-%d\")}\n",
        "\n",
        "SUMMARY\n",
        "-------\n",
        "Total patients    : {len(df)}\n",
        "High-risk patients: {len(high_risk_df)}\n",
        "Drug alerts       : {len(alerts_df)}\n",
        "\n",
        "HIGH-RISK PATIENTS\n",
        "------------------\n",
        "{high_risk_names}\n",
        "\n",
        "DRUG INTERACTION ALERTS\n",
        "-----------------------\n",
        "{alert_details}\n",
        "\n",
        "FILES SAVED\n",
        "-----------\n",
        "- {OUTPUT_FILES['all_patients']}\n",
        "- {OUTPUT_FILES['high_risk']}\n",
        "- {OUTPUT_FILES['drug_interactions']}\n",
        "\n",
        "This is an automated message. Do not reply.\n",
        "\"\"\"\n",
        "    return report\n",
        "\n",
        "# Generate and print\n",
        "print(generate_email_report(df, high_risk_df, alerts_df))\n"
      ],
