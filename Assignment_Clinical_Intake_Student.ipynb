        "\n",
        "interactions = pd.DataFrame([\n",
        "    {\"drug1\": \"Warfarin\",      \"drug2\": \"Metronidazole\", \"interaction_severity\": \"HIGH\",     \"description\": \"Elevated INR, serious bleeding risk\"},\n",
